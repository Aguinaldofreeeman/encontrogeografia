rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'aguinaldofreeman@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidImageUrl(url) {
      return url is string &&
        url.size() >= 5 &&
        url.size() <= 750000 && (
          (url.size() >= 11 && url[0:11] == 'data:image/') ||
          (url.size() >= 12 && url[0:12] == '/src/assets/') ||
          (url.size() >= 8 && url[0:8] == 'https://') ||
          (url.size() >= 7 && url[0:7] == 'http://')
        );
    }

    function isValidPhoto(data) {
      return data.keys().hasAll([
        'category',
        'title',
        'caption',
        'imageUrl',
        'yearLabel',
        'location',
        'photographer',
        'plateCode',
        'featured',
        'visibility',
        'authorUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'category',
        'title',
        'caption',
        'imageUrl',
        'yearLabel',
        'location',
        'photographer',
        'plateCode',
        'featured',
        'visibility',
        'authorUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.category in ['historico', 'formatura', 'turma'] &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
      data.caption is string && data.caption.size() >= 4 && data.caption.size() <= 1200 &&
      isValidImageUrl(data.imageUrl) &&
      data.yearLabel is string && data.yearLabel.size() >= 2 && data.yearLabel.size() <= 40 &&
      data.location is string && data.location.size() >= 2 && data.location.size() <= 120 &&
      data.photographer is string && data.photographer.size() >= 2 && data.photographer.size() <= 100 &&
      data.plateCode is string && data.plateCode.size() >= 2 && data.plateCode.size() <= 30 &&
      data.featured is bool &&
      data.visibility in ['public', 'draft'] &&
      isValidId(data.authorUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidComment(data) {
      return data.keys().hasAll([
        'photoId',
        'targetType',
        'authorName',
        'authorRelation',
        'text',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'photoId',
        'targetType',
        'authorName',
        'authorRelation',
        'text',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.photoId) &&
      data.targetType in ['photo', 'album'] &&
      data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80 &&
      data.authorRelation in ['Colega de Turma', 'Familiar', 'Docente', 'Convidado'] &&
      data.text is string && data.text.size() >= 4 && data.text.size() <= 800 &&
      data.status in ['pending', 'approved'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSettings(data) {
      return data.keys().hasAll([
        'courseTitle',
        'degreeLabel',
        'classYear',
        'institution',
        'introText',
        'updatedByUid',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'courseTitle',
        'degreeLabel',
        'classYear',
        'institution',
        'introText',
        'updatedByUid',
        'updatedAt'
      ]) &&
      data.courseTitle is string && data.courseTitle.size() >= 3 && data.courseTitle.size() <= 120 &&
      data.degreeLabel is string && data.degreeLabel.size() >= 3 && data.degreeLabel.size() <= 120 &&
      data.classYear is string && data.classYear.size() >= 2 && data.classYear.size() <= 30 &&
      data.institution is string && data.institution.size() >= 2 && data.institution.size() <= 140 &&
      data.introText is string && data.introText.size() >= 10 && data.introText.size() <= 1000 &&
      isValidId(data.updatedByUid) &&
      data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll([
        'email',
        'displayName',
        'role',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'email',
        'displayName',
        'role',
        'createdAt'
      ]) &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
      data.role == 'admin' &&
      data.createdAt is timestamp;
    }

    match /photos/{photoId} {
      allow get: if isValidId(photoId) && (existing().visibility == 'public' || isAdmin());
      allow list: if existing().visibility == 'public' || isBootstrappedAdmin();
      allow create: if isValidId(photoId) &&
        isAdmin() &&
        isValidPhoto(incoming()) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(photoId) &&
        isAdmin() &&
        isValidPhoto(incoming()) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'category',
          'title',
          'caption',
          'imageUrl',
          'yearLabel',
          'location',
          'photographer',
          'plateCode',
          'featured',
          'visibility',
          'updatedAt'
        ]);
      allow delete: if isValidId(photoId) && isAdmin();
    }

    match /comments/{commentId} {
      allow get: if isValidId(commentId) && (existing().status == 'approved' || isAdmin());
      allow list: if existing().status == 'approved' || isBootstrappedAdmin();
      allow create: if isValidId(commentId) &&
        isValidComment(incoming()) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (incoming().targetType == 'album' && incoming().photoId == 'album') ||
          (incoming().targetType == 'photo' && exists(/databases/$(database)/documents/photos/$(incoming().photoId)))
        );
      allow update: if isValidId(commentId) &&
        isAdmin() &&
        isValidComment(incoming()) &&
        incoming().photoId == existing().photoId &&
        incoming().targetType == existing().targetType &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'authorName',
            'authorRelation',
            'text',
            'status',
            'updatedAt'
          ])
        );
      allow delete: if isValidId(commentId) && isAdmin();
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'album';
      allow list: if false;
      allow create: if isValidId(settingId) &&
        settingId == 'album' &&
        isAdmin() &&
        isValidSettings(incoming()) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(settingId) &&
        settingId == 'album' &&
        isAdmin() &&
        isValidSettings(incoming()) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'courseTitle',
          'degreeLabel',
          'classYear',
          'institution',
          'introText',
          'updatedByUid',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isAdmin() || (isVerifiedUser() && request.auth.uid == adminUid));
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(adminUid) &&
        isAdmin() &&
        isValidAdminUser(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(adminUid) &&
        isAdmin() &&
        isValidAdminUser(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName']);
      allow delete: if isValidId(adminUid) && isBootstrappedAdmin() && adminUid != request.auth.uid;
    }
  }
}
